{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(git:*)",
      "PowerShell(git:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "PowerShell(git push:*)",
      "PowerShell(git remote:*)",
      "Bash(git config --global:*)",
      "PowerShell(git config --global:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(Invoke-RestMethod:*)",
      "Bash(agy:*)",
      "Bash(antigravity:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm -rf:*)",
      "Edit(//**/_meta/**)",
      "Edit(//**/general/**)",
      "Edit(//**/inicializador/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)"
    ]
  },
  "model": "sonnet",
  "effortLevel": "medium",
  "outputStyle": "Concise",
  "crossSessionInbound": "refuse",
  "isolatePeerMachines": true,
  "attribution": {
    "commit": ""
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1"
  }
}
