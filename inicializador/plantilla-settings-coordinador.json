{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "../../general",
      "../../_meta/memoria"
    ],
    "allow": [
      "WebSearch",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(pwd:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(file:*)",
      "Bash(stat:*)",
      "Bash(git:*)",
      "PowerShell(git:*)"
    ],
    "deny": [
      "Write(//**/general/**)",
      "Edit(//**/general/**)",
      "Write(//**/_meta/**)",
      "Edit(//**/_meta/**)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "PowerShell(git push:*)",
      "PowerShell(git remote:*)",
      "Bash(git config --global:*)",
      "PowerShell(git config --global:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(Invoke-RestMethod:*)",
      "Bash(agy:*)",
      "Bash(antigravity:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm -rf:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/../../general/comun/hooks/limpieza-coordinacion.mjs\""
          }
        ]
      }
    ]
  },
  "model": "opus",
  "effortLevel": "high",
  "crossSessionInbound": "accept",
  "isolatePeerMachines": true,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  }
}
